# Offline development works without credentials. Never commit your real .env.
P2P_PROVIDER=offline
P2P_RUNNER=disabled
P2P_MODEL=
P2P_BASE_URL=
MODEL_API_KEY=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
# Reserved for future persistence; these services are not required yet.
P2P_DATABASE_URL=
P2P_REDIS_URL=
P2P_MAX_MODEL_CALLS=20
P2P_MAX_REPAIRS=3
P2P_INVOCATION_TIMEOUT_SECONDS=180
P2P_RUN_TIMEOUT_SECONDS=900
P2P_MODEL_BUDGET_USD=2
